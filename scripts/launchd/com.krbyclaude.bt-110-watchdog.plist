<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- (#242) #110 백필 워치독 — 30분마다 bt_watchdog_110.sh. 설치는 사용자 수동(웹 등록 금지, #86):
     cp scripts/launchd/com.krbyclaude.bt-110-watchdog.plist ~/Library/LaunchAgents/
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.krbyclaude.bt-110-watchdog.plist
     경로는 핀 worktree(bt-110-run) 고정 — 재핀 시 worktree 를 같은 경로에 다시 만든다. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.krbyclaude.bt-110-watchdog</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>ProgramArguments</key><array><string>/Users/hank.es/git/personal/kr-by-claude-worktrees/bt-110-run/scripts/bt_watchdog_110.sh</string></array>
  <key>StartInterval</key><integer>1800</integer>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/Users/hank.es/.kr-by-claude/launchd-bt-110-watchdog.log</string>
  <key>StandardErrorPath</key><string>/Users/hank.es/.kr-by-claude/launchd-bt-110-watchdog.log</string>
</dict></plist>
