# schedule.env — 저녁 체인 시각의 단일 정의 (#207 회신 20, 2026-09-29). 대입문만(부작용 없음) —
# install.sh(plist 생성·pmset 검사)·lib_guards.sh(장중 자물쇠·감시 판정)가 source 한다.
# 근거: KRX 전종목시세는 애프터마켓(16:00~20:00) 중 20분 지연 잠정값 → 확정 하한 20:20.
EVENING_HOUR=20
EVENING_MIN=30
WAKE_TIME="20:25:00"          # sudo pmset repeat wakeorpoweron MTWRFS $WAKE_TIME
INTRADAY_LOCK_END_HOUR=20     # 09:00 ~ 이 시각 전까지 데이터 체인 차단(잠정값 창: 정규장 + 애프터마켓 + 20분 지연)
INTRADAY_LOCK_END_MIN=25
WATCH_DUE_HOUR=23             # 결측(miss.*)·stale 판정 시작 = 발화 20:30 + 데이터 체인 최대 2h10m 실측 + ohlcv 잠정값 재조회 대기 10분(PROVISIONAL_RETRY_WAIT_S) + ELTD 재시도 최대 4분(#228: 3회×120s 대기 2회) + 여유 ~6분. 이 시각에도 체인이 data 락을 쥐고 있으면 감시 3a 는 판정을 다음 시각으로 미룬다(#228)
