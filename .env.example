DATABASE_URL=postgresql://localhost/kr_pipeline
TEST_DATABASE_URL=postgresql://localhost/kr_test
LOG_LEVEL=INFO

# (#281) AI 분석 전문가 채팅 — 모두 선택. 비우면 기본값.
# 조회 전용 접속 주소. 비우면 DATABASE_URL 의 계정만 kr_chat_ro 로 바꾼 주소를 쓴다
# (계정 생성: psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f kr_pipeline/db/chat_ro_role.sql).
# CHAT_DATABASE_URL=postgresql://kr_chat_ro@localhost/kr_pipeline
# 채팅 모델(기본 sonnet). 운영 분류의 KR_CLAUDE_MODEL 과 별개다.
# KR_CHAT_MODEL=sonnet
# 대화 저장 폴더(기본 data/chats).
# KR_CHAT_DIR=
DART_API_KEY=here_paste_your_40_char_key

# 토스증권 Open API (spec docs/superpowers/specs/2026-09-14-toss-trading-page-design.md §9)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# GET /trade-api/accounts 로 확인 후 고정 (accountType=BROKERAGE)
TOSS_ACCOUNT_SEQ=
# 기본 true. 실주문은 명시적으로 false
TOSS_DRY_RUN=true
GUARD_MAX_ORDER_KRW=5000000
GUARD_MAX_DAILY_KRW=10000000
